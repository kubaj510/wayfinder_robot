<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="lidar_link">
        <visual>
            <geometry><cylinder radius="0.05" length="0.04"/></geometry>
            <material name="brown"/>
        </visual>

        <collision>
            <geometry><cylinder radius="0.05" length="0.04"/></geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="0.0001" iyy="0.0001" izz="0.000125" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="0.15 0 0.095" rpy="0 0 0"/>
    </joint>

    <gazebo reference="lidar_link">
        <sensor name="lidar_sensor" type="gpu_lidar">
            <update_rate>10</update_rate>
            <topic>scan</topic>
            <frame_id>lidar_link</frame_id>
            <gz_frame_id>lidar_link</gz_frame_id>
            <visualize>true</visualize>

            <lidar>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>

                <range>
                    <min>0.52</min>
                    <max>12.0</max>
                    <resolution>0.01</resolution>
                </range>
            </lidar>
        </sensor>
    </gazebo>


    <link name="camera_link">
        <visual>
            <geometry><box size="0.03 0.06 0.03"/></geometry>
            <material name="black"/>
        </visual>

        <collision>
            <geometry><box size="0.03 0.06 0.03"/></geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.05"/>
            <inertia ixx="0.00002" iyy="0.00001" izz="0.00002" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="camera_link"/>
        <origin xyz="0.22 0 0.08" rpy="0 0 0"/>
    </joint>

    <gazebo reference="camera_link">
        <sensor name="camera_sensor" type="camera">
            <update_rate>15</update_rate>
            <topic>camera/image_raw</topic>
            <gz_frame_id>camera_link</gz_frame_id>
            <visualize>true</visualize>
            <camera>
                <horizontal_fov>1.3</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>20.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

 </robot>
