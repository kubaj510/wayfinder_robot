<?xml version="1.0"?>
<robot name="wayfinder" xmlns:xacro="https://wiki.ros.org/xacro">

    <xacro:include filename="$(find wayfinder_description)/urdf/wheel.xacro"/>

    <material name="green"><color rgba="0.4 0.6 0.2 1.0"/></material>
    <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    <material name="brown"><color rgba="0.82 0.70 0.55 1.0"/></material>


    <link name="base_footprint"/>

    <link name="base_link">
        <visual>
            <geometry><box size="0.5 0.4 0.15"/></geometry>
            <material name="green"/>
        </visual>

        <collision>
            <geometry><box size="0.5 0.4 0.15"/></geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="3.0"/>
            <inertia ixx="0.045625" iyy="0.068125" izz="0.1025" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.13" rpy="0 0 0"/>
    </joint>

    <xacro:wheel prefix="front_left"  x_offset="0.18"  y_offset="0.21"/>
    <xacro:wheel prefix="front_right" x_offset="0.18"  y_offset="-0.21"/>
    <!--
        <xacro:wheel prefix="rear_left"   x_offset="-0.18" y_offset="0.21"/>
        <xacro:wheel prefix="rear_right"  x_offset="-0.18" y_offset="-0.21"/>
    -->

    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="0.04"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.04"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="0.000064" iyy="0.000064" izz="0.000064" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="caster_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel_link"/>
        <origin xyz="-0.18 0 -0.09" rpy="0 0 0"/>
    </joint>

    <gazebo reference="caster_wheel_link">
        <mu1>0.0</mu1>
        <mu2>0.0</mu2>
    </gazebo>

    <xacro:include filename="$(find wayfinder_description)/urdf/sensors.xacro"/>
    <xacro:include filename="$(find wayfinder_description)/urdf/ros2_control.xacro"/>

</robot>
