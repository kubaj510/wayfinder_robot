    </model>

    <model name="marker_post_4">
      <static>true</static>
      <pose>2.5 -2.5 0.21 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.01 0.4 0.4</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>/workspace/src/wayfinder_gazebo/worlds/marker_4.png</albedo_map>
              </metal>
